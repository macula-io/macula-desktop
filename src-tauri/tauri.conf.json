  "productName": "macula-desktop",
  "version": "0.1.0",
  "identifier": "io.macula.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
